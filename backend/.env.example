PORT=4000
CORS_ORIGIN=http://localhost:3000

# Google Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Optional fallback model used when the primary hits capacity/quota errors.
# Leave empty to disable. Only set a model verified against the extraction
# schema — some models (gemini-3.5-flash, gemini-3.1-flash-lite) silently
# drop rows/fields on structured output.
GEMINI_FALLBACK_MODEL=

# Number of CSV rows sent to the AI per request, and how many batches run in parallel.
AI_BATCH_SIZE=20
AI_BATCH_CONCURRENCY=3
