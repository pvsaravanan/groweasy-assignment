# Used by `docker compose up` for ${VAR} substitution in docker-compose.yml.
# Copy to .env (same directory as docker-compose.yml) and fill in your key:
#   cp .env.example .env
#
# This is separate from backend/.env and frontend/.env.local, which are only
# read when running each service directly with `npm run dev` (not via Docker).

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=
AI_BATCH_SIZE=20
AI_BATCH_CONCURRENCY=3
